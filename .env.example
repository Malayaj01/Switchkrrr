# Pooled connection used by the app at runtime.
# On a serverless host (Vercel + Neon), this must be the POOLED endpoint.
DATABASE_URL="postgresql://switchkrr:switchkrr@localhost:5432/switchkrr"

# Unpooled connection used by prisma migrate, which cannot run through a pooler.
# Locally this is the same as DATABASE_URL. On Neon, use the direct endpoint.
DIRECT_URL="postgresql://switchkrr:switchkrr@localhost:5432/switchkrr"

# Must be at least 32 characters. Generate a fresh one for production.
SESSION_SECRET="replace-with-a-long-random-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
